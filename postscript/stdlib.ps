%!
% stdlib.ps: generic utilities.

% The auxiliary stack. Should not be accessed directly outside
% of this file.
/_xstack [] def

% The auxiliary stack mark. Should not be accessed directly
% outside of this file.
/_xmark [/_xmark] def

% val xpush  -->  -
%
% Push a value onto the auxiliary stack.
/xpush {
    /_xstack exch [exch _xstack aload length 1 add -1 roll] def
} bind def

% xpop  -->  val
%
% Pop one value from the auxiliary stack.
/xpop {
    [_xstack aload length 1 add 1 roll] /_xstack exch def
} bind def

% xtop  -->  val
%
% Obtain the top element of the auxiliary stack without popping.
/xtop {
    _xstack dup length 1 sub get
} bind def

% xdrop  -->  -
%
% Discard the top element of the auxiliary stack.
/xdrop {
    xpop pop
} bind def

% xclear  -->  -
%
% Clear the auxiliary stack.
/xclear {
    /_xstack [] def
} bind def

% xempty  -->  bool
%
% Determine whether the auxiliary stack is empty.
/xempty {
    _xstack length 0 eq
} bind def

% xmark  -->  -
%
% Push a marker onto the stack.
/xmark {
    _xmark xpush
} bind def

% xunmark  -->  -
%
% If the marker is at the top of the auxiliary stack, discard it.
% Otherwise, raise an error.
/xunmark {
    % TODO: do this properly.
    xpop dup _xmark eq {
        pop
    } {
        (should have been [/_xmark]:) = == __error_in_xcheck__
    } ifelse
} bind def

% {proc} xmarked  -->  proc'
%
% Wrap any procedure with xmark/xunmark.
/xmarked {
    [/xmark cvx 3 -1 roll /exec cvx /xunmark cvx] cvx
} bind def

% /name val setdefault  -->  -
%
% Set /name to val, if it is not defined in userdict.
/setdefault {
    2 dict begin
        /val exch def
        /name exch def
        userdict name known not {name val def} if
    end
} def

% array0 array1 acat  -->  array'
%
% Concatenate 2 arrays.
/acat {
    [ 3 1 roll ] flatten
} def

% [array0 array1 ... ] flatten  -->  array'
%
% Flatten an array of arrays.
/flatten {
    [ exch {aload pop} forall ]
} def

% [v_0 ... v_{n-1}] reverse  -->  [v_{n-1} ... v_0]
%
% Reverse an arbitrary array.
/reverse {
    [exch dup dup length 1 sub -1 0 {get exch dup} for pop pop]
} bind def

% v_0 ... v_{n-1} [/name_0 ... /name_{n-1}] vdef  --> -
%
% Bind multiple names in order.
/vdef {
    reverse {exch def} forall
} bind def

% x0 y0 x1 y1 cx  -->  x0*y1 - x1*y0
/cx {
    4 1 roll mul 3 1 roll mul exch sub
} bind def

% x0 y0 x1 y1 x2 y2 triangle-area  -->  area
%
% Compute the signed area of a triangle.
/triangle-area {
    6 dict begin
        {x0 y0 x1 y1 x2 y2} vdef
        x1 x0 sub y1 y0 sub x2 x0 sub y2 y0 sub cx 2 div
    end
} bind def

% x1 y1 x2 y2 x3 y3 x0 y0 curve-area-delta  -->  area
%
% Compute the signed area of a curve segment with an implied
% closepath.
/curve-area-delta {
    8 dict begin
        {x0 y0} vdef
        y0 sub /y3 exch def
        x0 sub /x3 exch def
        y0 sub /y2 exch def
        x0 sub /x2 exch def
        y0 sub /y1 exch def
        x0 sub /x1 exch def
        x1 y1 x2 x3 add y2 y3 add cx 0.15 mul
        x2 y2 x3 y3 cx 0.3 mul
        add
    end
} bind def

% - area  -->  -
%
% Compute the signed area enclosed by the current path. Note that non-simple
% regions are allowed and may give surprising results (e.g., with overlaps
% possibly being counted multiple times).
/area {
    6 dict begin
        /a 0 def
        /a' 0 def
        {
            % moveto callback
            2 copy
            {x y x0 y0} vdef
            /a' 0 def
        }
        {
            % lineto callback
            2 copy
            x0 y0 x y triangle-area /a' exch a' add def
            {x y} vdef
        }
        {
            % curveto callback
            2 copy
            x0 y0 x y triangle-area /a' exch a' add def
            2 copy 8 2 roll
            x y curve-area-delta /a' exch a' add def
            {x y} vdef
        }
        {
            % closepath callback
            /a a a' add def
            /a' 0 def
        }
        pathforall
        a
    end
} bind def

% a{0} ... a{n-1} n dump!  -->  -
/dump! {
    array astore ==
} bind def

% a{0} ... a{n-1} n dump  -->  a{0} ... a{n-1}
/dump {
    [exch dup /copy cvx exch] cvx exec dump!
} bind def

% x y max  -->  max(x, y)
/max { 2 copy lt {exch} if pop } bind def

% x y min  -->  min(x, y)
/min { 2 copy gt {exch} if pop } bind def

% x xmin xmax clamp  -->  max(min(x, xmax), xmin)
/clamp { 3 -1 roll min max } bind def
