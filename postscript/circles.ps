%!

% A circle is represented as [x y r] (center coordinates and radius)

% x y r circle -> <circle with center (x, y) and radius r>
% constructor
/circle { [ 4 1 roll ] } bind def

% C getx -> <x-coordinate of center of C>
% C gety -> <y-coordinate of center of C>
% C getr -> <radius of C>
% C getc -> <x-coord. of C> <y-coord. of C>
% deconstructors
/getx { aload pop pop pop } bind def
/gety { aload pop 3 -1 roll pop pop } bind def
/getr { aload pop 3 1 roll pop pop } bind def
