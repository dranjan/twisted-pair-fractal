% various programs
/include_complex { (complex.ps) run } def
/include_circles { (circles.ps) run } def
/include_mobT { (moebius.ps) run } def
/include_permute { (permute.ps) run } def

/apol { /threshold exch def (invtest.ps) run } def


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% constants

/stddefs {
    define_E
    define_phis
    define_Pi
} def
/define_E { /E 2.71828182845904524 def } def
/define_phis {
    /phi 5 sqrt 1 sub 2 div def
    /Phi 5 sqrt 1 add 2 div def
} def
/define_Pi { /Pi 3.1415926536 def } def
